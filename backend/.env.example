# ===================================
# Backend Environment Configuration
# ===================================

# -------------------------------------
# Node Environment
# -------------------------------------
NODE_ENV=development
# Options: development, production

# -------------------------------------
# Server Configuration
# -------------------------------------
PORT=4000
# The port the backend server will listen on
# Note: Render.com will override this with its own PORT value

# -------------------------------------
# Database Configuration (PostgreSQL)
# -------------------------------------
DB_HOST=localhost
# For local development: localhost
# For Render: dpg-xxxx.region-postgres.render.com (without /database_name)

DB_PORT=5432
# Standard PostgreSQL port

DB_USERNAME=postgres
# Your database username
# For Render: Check your database credentials page

DB_PASSWORD=postgres
# Your database password
# For Render: Use the password from Render database credentials

DB_DATABASE=collab_task_hub
# Your database name
# For Render: Check your database credentials page

# Alternative: Use full database URL (comment out individual vars above if using this)
# DATABASE_URL=postgresql://username:password@host:5432/database

# -------------------------------------
# JWT Authentication
# -------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
# IMPORTANT: Generate a strong random secret for production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or: openssl rand -hex 32

JWT_EXPIRES_IN=7d
# Token expiration time (e.g., 1h, 24h, 7d, 30d)

# -------------------------------------
# CORS Configuration
# -------------------------------------
CORS_ORIGIN=http://localhost:3000
# Comma-separated list of allowed origins
# For local development: http://localhost:3000
# For production: https://your-frontend-domain.onrender.com
# Multiple origins: https://app.example.com,https://admin.example.com

# -------------------------------------
# Logging
# -------------------------------------
LOG_LEVEL=info
# Options: error, warn, info, debug, verbose
