# ===================================
# Production Environment Configuration
# ===================================
# This file shows example values for deploying to Render.com

# -------------------------------------
# Backend Database Configuration
# -------------------------------------
DB_HOST=dpg-xxxx.region-postgres.render.com
# Render PostgreSQL hostname (without /database_name)
# Example: dpg-d5pkevf5c7fs73bp9ou0-a.frankfurt-postgres.render.com

DB_PORT=5432
DB_USERNAME=your_database_user
# From Render database credentials page

DB_PASSWORD=your_database_password_CHANGE_ME
# From Render database credentials page

DB_DATABASE=your_database_name
# From Render database credentials page

# -------------------------------------
# Backend Application Configuration
# -------------------------------------
PORT=4000
# Note: Render will override this automatically

NODE_ENV=production

# -------------------------------------
# Backend Security Configuration
# -------------------------------------
JWT_SECRET=your_jwt_secret_key_CHANGE_ME_MINIMUM_32_CHARACTERS
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_EXPIRES_IN=7d

CORS_ORIGIN=https://your-frontend.onrender.com
# Your frontend URL on Render
# Example: https://collab-task-hub-frontend.onrender.com

# -------------------------------------
# Frontend Configuration
# -------------------------------------
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
# Your backend URL on Render
# Example: https://collab-task-hub-backend.onrender.com

NEXT_PUBLIC_WS_URL=https://your-backend.onrender.com
# WebSocket URL (same as backend URL)

# -------------------------------------
# Optional: Docker Configuration
# -------------------------------------
DOCKER_REGISTRY=your-registry.io/your-username
VERSION=latest

# -------------------------------------
# Optional: Nginx Configuration
# -------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# -------------------------------------
# Logging
# -------------------------------------
LOG_LEVEL=info
